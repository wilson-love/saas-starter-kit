# ============================================================
# overseas-saas-starter 环境变量模板
# 1) cp .env.example .env
# 2) pnpm setup:local  （生成随机 BETTER_AUTH_SECRET 并跑迁移）
# 3) 按下方说明逐个填充，pnpm check:config 可校验
# 完整获取指南见 docs/DEVELOPER_HANDOFF.md
# ============================================================

# ---- Web ----
# 本地开发保持 http://localhost:3000；生产填最终 HTTPS 域名
APP_URL=http://localhost:3000

# better-auth 密钥：>=32 字符随机串（生产必填）
# 生成：openssl rand -base64 48
BETTER_AUTH_SECRET=dev-insecure-change-me
BETTER_AUTH_URL=http://localhost:3000

# ---- 数据库（Neon Postgres）----
# 在 Neon 控制台建项目 → 复制连接串（pooled 或 direct 均可）
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# ---- 支付：Gumroad（基座默认收款渠道）----
# 在 Gumroad 后台创建三个产品（一次性 + Pro 订阅 + Creator 订阅），然后填：
#   产品页链接 → PAYMENT_LINK_ONEOFF / CHECKOUT_URL_PRO / CHECKOUT_URL_CREATOR
#   产品 ID（产品编辑页可查）→ GUMROAD_PRODUCT_*
#   seller_id（后台 Settings → Advanced 或 profile URL 可查）→ GUMROAD_SELLER_ID
PAYMENT_PROVIDER=gumroad
PAYMENT_LINK_ONEOFF=
CHECKOUT_URL_PRO=
CHECKOUT_URL_CREATOR=
GUMROAD_PRODUCT_ONEOFF=
GUMROAD_PRODUCT_PRO=
GUMROAD_PRODUCT_CREATOR=

# Gumroad 无 webhook 签名，安全靠共享密钥 + seller_id 白名单：
# 在 Gumroad Settings → Advanced 把 Ping URL 配成
#   https://<你的域名>/api/billing/gumroad/webhook?token=<GUMROAD_WEBHOOK_SECRET>
GUMROAD_WEBHOOK_SECRET=
GUMROAD_SELLER_ID=

# ---- 邮件：Resend ----
# https://resend.com/api-keys ；发信前先在 Resend 验证你的发信域名
RESEND_API_KEY=
# 必须使用你验证过的域名，形如 'Display Name <noreply@yourdomain.com>'
EMAIL_FROM=Your SaaS <noreply@yourdomain.com>

# ---- 可观测 ----
# 漏斗报表 API 的访问 token（自建 /api/analytics 用）；留空则关闭
ANALYTICS_TOKEN=

# ---- LLM（可选；默认 none 纯确定性，不需要可不填）----
LLM_PROVIDER=none
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=deepseek-chat
