# ============================================================
# overseas-saas-starter 环境变量模板
# 1) cp .env.example .env
# 2) pnpm setup:local  （生成随机 BETTER_AUTH_SECRET 并跑迁移）
# 3) 按下方说明逐个填充，pnpm check:config 可校验
# 完整获取指南见 docs/DEVELOPER_HANDOFF.md
# ============================================================

# ---- Web ----
# 本地开发保持 http://localhost:3000；生产填最终 HTTPS 域名
APP_URL=http://localhost:3000

# better-auth 密钥：>=32 字符随机串（生产必填）
# 生成：openssl rand -base64 48
BETTER_AUTH_SECRET=dev-insecure-change-me
BETTER_AUTH_URL=http://localhost:3000

# ---- 数据库（Neon Postgres）----
# 在 Neon 控制台建项目 → 复制连接串（pooled 或 direct 均可）
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# ---- 支付：Creem（默认 MoR；PAYMENT_PROVIDER 可切 stripe/lemonsqueezy）----
PAYMENT_PROVIDER=creem
# Creem 控制台 → API Keys
CREEM_API_KEY=
# Creem 控制台 → Webhooks → 创建 webhook 时的签名密钥（只显示一次，注意保存）
CREEM_WEBHOOK_SECRET=
# 测试模式：true = 用 Creem test server（本地/预发布用），false = 生产
CREEM_TEST_MODE=false

# 阶段 0（零代码）：Creem 后台建好产品后，把托管结账链接填到这里
PAYMENT_LINK_ONEOFF=
CHECKOUT_URL_PRO=
CHECKOUT_URL_CREATOR=
# 阶段 1（webhook 自动识别套餐）：产品 ID
CREEM_PRODUCT_PRO=
CREEM_PRODUCT_CREATOR=
CREEM_PRODUCT_ONEOFF=

# ---- 邮件：Resend ----
# https://resend.com/api-keys ；发信前先在 Resend 验证你的发信域名
RESEND_API_KEY=
# 必须使用你验证过的域名，形如 'Display Name <noreply@yourdomain.com>'
EMAIL_FROM=Your SaaS <noreply@yourdomain.com>

# ---- 可观测 ----
# 漏斗报表 API 的访问 token（自建 /api/analytics 用）；留空则关闭
ANALYTICS_TOKEN=

# ---- LLM（可选；默认 none 纯确定性，不需要可不填）----
LLM_PROVIDER=none
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=deepseek-chat
